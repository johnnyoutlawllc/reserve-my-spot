# Supabase project that holds the rms_* tables.
# Copy to .env.local for local dev; set the same pair in the Vercel project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Contact form email (src/app/api/contact/route.ts).
# Without RESEND_API_KEY the form still works: every submission is written to
# spot.rms_contact_messages. The key is what makes it also reach an inbox.
# CONTACT_NOTIFY_TO defaults to sales@dataday.studio.
# MAIL_FROM_CONTACT defaults to "Reserve My Spot <noreply@reservemy.spot>" and
# must be a domain Resend has verified, or every send is refused.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
MAIL_FROM_CONTACT=
